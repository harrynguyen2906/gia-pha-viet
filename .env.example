# ─────────────────────────────────────────────────────────────────────────────
# Heritage Cloud — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase) ──────────────────────────────────────────────────────
# Connection Pooler (Transaction Mode, port 6543) — used at runtime by the app
DATABASE_URL="postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection (port 5432) — used for Prisma migrations only
DIRECT_URL="postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ── Google Maps ─────────────────────────────────────────────────────────────
# Setup guide: docs/refactor/RF-01-mapbox-to-google-maps.md §3 (API Key Setup)
#
# Quick steps:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create a project → Enable "Maps JavaScript API"
#   3. Create an API key → restrict to HTTP referrers + Maps JavaScript API
#   4. Paste the key below
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
