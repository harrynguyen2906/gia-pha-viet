# ─────────────────────────────────────────────────────────────────────────────
# Heritage Cloud — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Primary connection string (used by Prisma at runtime via PrismaClient)
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/heritagecloud"

# Direct (non-pooled) URL used by the pg Pool in prisma.ts
DIRECT_URL="postgres://USER:PASSWORD@HOST:5432/heritagecloud"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ── Google Maps ─────────────────────────────────────────────────────────────
# Setup guide: docs/refactor/RF-01-mapbox-to-google-maps.md §3 (API Key Setup)
#
# Quick steps:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create a project → Enable "Maps JavaScript API"
#   3. Create an API key → restrict to HTTP referrers + Maps JavaScript API
#   4. Paste the key below
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
