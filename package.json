{
  "name": "gia-pha-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Heritage Cloud (Gia Phả Việt) — Monorepo root",
  "packageManager": "npm@11.8.0",
  "scripts": {
    "db:generate": "npm run --workspace=@gia-pha/db db:generate",
    "db:migrate:dev": "npm run --workspace=@gia-pha/db db:migrate:dev",
    "db:migrate:deploy": "npm run --workspace=@gia-pha/db db:migrate:deploy",
    "db:migrate:status": "npm run --workspace=@gia-pha/db db:migrate:status",
    "db:seed": "npm run --workspace=@gia-pha/db db:seed",
    "db:seed:public": "npm run --workspace=@gia-pha/db db:seed:public",
    "db:seed:admin": "npm run --workspace=@gia-pha/db db:seed:admin",
    "db:studio": "npm run --workspace=@gia-pha/db db:studio",
    "db:reset": "npm run --workspace=@gia-pha/db db:reset",
    "db:validate": "npm run --workspace=@gia-pha/db db:validate",
    "db:format": "npm run --workspace=@gia-pha/db db:format",
    "postinstall": "npm run db:generate",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:root": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" --max-warnings=0",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json,css}\" \"packages/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json,css}\" \"packages/**/*.{ts,tsx,json}\"",
    "typecheck": "turbo run typecheck",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "packages/**/*.{ts,tsx}": [
      "prettier --write"
    ],
    "**/*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "turbo": "^2.9.3"
  }
}
