# ─────────────────────────────────────────────────────────────────────────────
# Heritage Cloud — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase) ──────────────────────────────────────────────────────
# Connection Pooler (Transaction Mode, port 6543) — used at runtime by the app
# Source: Supabase Dashboard → Project Settings → Database → Connection Pooling
DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# Direct / Session Connection (port 5432) — used for Prisma migrations only
# Source: Supabase Dashboard → Project Settings → Database → Connection String
DIRECT_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-strong-random-secret"
# NextAuth v5 uses AUTH_URL; NEXTAUTH_URL is kept for compatibility
AUTH_URL="https://your-production-domain.com"
NEXTAUTH_URL="https://your-production-domain.com"

# ── Google Maps ──────────────────────────────────────────────────────────────
# Setup guide: docs/refactor/RF-01-mapbox-to-google-maps.md §3 (API Key Setup)
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create a project → Enable "Maps JavaScript API"
#   3. Create an API key → restrict to HTTP referrers + Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── Supabase — Public (safe to use in browser) ────────────────────────────────
# Source: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ── Supabase — Server-side only (NEVER expose to browser) ────────────────────
# Used for admin DB operations, RLS bypass, Edge Functions (future)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"
SUPABASE_SECRET_KEY="sb_secret_..."
# Personal Access Token for Supabase CLI (npm run db:types).
# Get it at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# ── Supabase Postgres — Raw connection info (informational, from dashboard) ───
data_POSTGRES_DATABASE="postgres"
data_POSTGRES_HOST="db.[project-ref].supabase.co"
data_POSTGRES_USER="postgres"
data_POSTGRES_PASSWORD="your-db-password"
data_POSTGRES_URL="postgres://..."
data_POSTGRES_PRISMA_URL="postgres://...?sslmode=require&pgbouncer=true"
data_POSTGRES_URL_NON_POOLING="postgres://...?sslmode=require"

# ── Dev credentials (seeded by prisma/seed.ts) ────────────────────────────────
Admin:  admin@heritage.local / heritage2025!
Editor: editor@heritage.local / editor2025!
