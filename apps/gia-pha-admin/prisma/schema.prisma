generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["admin", "public"]
}

model User {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String       @unique @db.VarChar(255)
  passwordHash String?      @map("password_hash") @db.VarChar(255)
  clanId       String?      @map("clan_id") @db.Uuid
  memberId     String?      @map("member_id") @db.Uuid
  isActive     Boolean      @default(true) @map("is_active")
  lastLoginAt  DateTime?    @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  role         UserRole     @default(GUEST)
  profile      UserProfile?
  clan         Clan?        @relation(fields: [clanId], references: [id])
  subscriptions UserSubscription[]
  orders        Order[]

  @@map("users")
  @@schema("public")
}

model UserProfile {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String  @unique @map("user_id") @db.Uuid
  displayName String  @map("display_name") @db.VarChar(100)
  avatarUrl   String? @map("avatar_url") @db.VarChar(500)
  phone       String? @db.VarChar(20)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
  @@schema("public")
}

model Clan {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  users     User[]
  subscriptions UserSubscription[]
  orders        Order[]

  @@map("clans")
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model duties {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clan_id         String       @db.Uuid
  title           String       @db.VarChar(300)
  description     String?
  category        DutyCategory
  status          DutyStatus   @default(QUEUE)
  priority        DutyPriority @default(MEDIUM)
  progress        Int          @default(0)
  assigned_to     String?      @db.Uuid
  assigned_by     String?      @db.Uuid
  ritual_event_id String?      @db.Uuid
  due_date        DateTime?    @db.Date
  verified_by     String?      @db.Uuid
  verified_at     DateTime?    @db.Timestamptz(6)
  created_by      String?      @db.Uuid
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @db.Timestamptz(6)
  deleted_at      DateTime?    @db.Timestamptz(6)

  @@index([assigned_to])
  @@index([clan_id])
  @@index([clan_id, status])
  @@index([ritual_event_id])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model duty_logs {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  duty_id      String   @db.Uuid
  action       String   @db.VarChar(50)
  old_value    String?  @db.VarChar(100)
  new_value    String?  @db.VarChar(100)
  performed_by String?  @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([duty_id, created_at(sort: Desc)])
  @@index([duty_id], map: "idx_duty_logs_duty_clan")
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model grave_sites {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  member_id     String        @unique @db.Uuid
  clan_id       String        @db.Uuid
  section_plot  String?       @db.VarChar(200)
  latitude      Decimal       @db.Decimal(10, 8)
  longitude     Decimal       @db.Decimal(11, 8)
  epitaph       String?
  condition     SiteCondition @default(MAINTAINED)
  site_type     SiteType      @default(CEMETERY)
  last_visited  DateTime?     @db.Date
  registered_by String?       @db.Uuid
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime      @db.Timestamptz(6)
  deleted_at    DateTime?     @db.Timestamptz(6)

  @@index([clan_id, condition])
  @@index([clan_id])
  @@index([member_id])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model member_media {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  member_id     String    @db.Uuid
  media_type    MediaType
  url           String
  thumbnail_url String?
  caption       String?   @db.VarChar(500)
  sort_order    Int       @default(0)
  file_size     Int?
  mime_type     String?   @db.VarChar(100)
  width         Int?
  height        Int?
  uploaded_by   String?   @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  @@index([member_id, media_type])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model member_spouses {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  member_a_id   String    @db.Uuid
  member_b_id   String    @db.Uuid
  marriage_date DateTime? @db.Date
  divorce_date  DateTime? @db.Date
  is_current    Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([member_a_id, member_b_id])
  @@index([member_a_id])
  @@index([member_b_id])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model members {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clan_id          String      @db.Uuid
  full_name        String      @db.VarChar(200)
  gender           GenderType  @default(MALE)
  is_deceased      Boolean     @default(false)
  birth_date_solar DateTime?   @db.Date
  birth_date_lunar String?     @db.VarChar(50)
  death_date_solar DateTime?   @db.Date
  death_date_lunar String?     @db.VarChar(50)
  departure_rite   String?
  avatar_url       String?
  biography        String?
  generation       Int         @default(1)
  lineage_role     LineageRole @default(MEMBER)
  branch_name      String?     @db.VarChar(100)
  created_by       String?     @db.Uuid
  created_at       DateTime    @default(now()) @db.Timestamptz(6)
  updated_at       DateTime    @db.Timestamptz(6)
  deleted_at       DateTime?   @db.Timestamptz(6)

  @@index([clan_id, full_name])
  @@index([clan_id, generation])
  @@index([clan_id])
  @@index([clan_id, is_deceased])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model notifications {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String           @db.Uuid
  type           NotificationType
  title          String           @db.VarChar(300)
  body           String?
  reference_type String?          @db.VarChar(50)
  reference_id   String?          @db.Uuid
  is_read        Boolean          @default(false)
  read_at        DateTime?        @db.Timestamptz(6)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)

  @@index([user_id], map: "idx_notifications_user_clan")
  @@index([user_id, is_read, created_at(sort: Desc)])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model password_reset_tokens {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token      String    @unique @db.VarChar(255)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  @@index([expires_at], map: "password_reset_tokens_expires_idx", where: raw("(used_at IS NULL)"))
  @@index([token])
  @@index([user_id])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model relationships {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parent_id         String           @db.Uuid
  child_id          String           @db.Uuid
  relationship_type RelationshipType @default(BIOLOGICAL)
  created_at        DateTime         @default(now()) @db.Timestamptz(6)

  @@unique([parent_id, child_id])
  @@index([child_id])
  @@index([parent_id])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
