# ─────────────────────────────────────────────────────────────
# @gia-pha/db — Environment Variables
# Copy this file to .env.local for local development
# ─────────────────────────────────────────────────────────────

# Supabase connection string (used by the app at runtime via pgBouncer)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true&sslmode=require"

# Direct connection URL (used for migrations — bypasses pgBouncer)
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
