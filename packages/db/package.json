{
  "name": "@gia-pha/db",
  "version": "1.0.0",
  "description": "Shared Prisma database layer for Gia Phả Việt (Heritage Cloud)",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "db:generate": "npx prisma generate --config prisma.config.ts",
    "db:migrate:deploy": "npx prisma migrate deploy --config prisma.config.ts",
    "db:migrate:dev": "npx prisma migrate dev --config prisma.config.ts",
    "db:migrate:status": "npx prisma migrate status --config prisma.config.ts",
    "db:studio": "npx prisma studio --config prisma.config.ts",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:seed:public": "tsx prisma/seed/seed-public.ts",
    "db:seed:admin": "tsx prisma/seed/seed-admin.ts",
    "db:reset": "npx prisma migrate reset --config prisma.config.ts",
    "db:format": "npx prisma format --config prisma.config.ts",
    "db:validate": "npx prisma validate --config prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "pg": "^8.20.0",
    "prisma": "^7.6.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "@types/bcryptjs": "^2.4.6",
    "dotenv": "^17.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
